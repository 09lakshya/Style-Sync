# Copy to backend/.env.production (git-ignored), fill in, then:
#   python backend/scripts/deploy_hf_space.py <user>/<space> --env-file backend/.env.production

# Your Vercel URL(s), comma-separated, no trailing slash.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# TiDB Cloud Serverless: Connect -> "General" connection string, then swap the
# scheme to mysql+aiomysql. Example:
# DATABASE_URL=mysql+aiomysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/stylesync
DATABASE_URL=
DATABASE_SSL=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Without these, uploaded images are stored in the database as base64.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=stylesync
